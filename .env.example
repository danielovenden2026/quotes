# Server-only values. Configure production through Sites environment settings.
# Comma-separated exact site-scoped authenticated user IDs. Empty denies everyone.
COST_ADMIN_USER_IDS=
# Temporary bootstrap only for the first standard-login sign-in. Remove after initialization.
VERDEX_INITIAL_ADMIN_PASSWORD=
COST_SHEET_ID=
COST_SHEET_TAB=Costs
COST_SOURCE_MODE=public-sheet

# Optional hosting-managed token (takes precedence over the encrypted setup form).
HUBSPOT_ACCESS_TOKEN=
# Base64-encoded 32-byte AES key for the admin HubSpot connection form.
# Keep stable: rotating it requires reconnecting HubSpot. Set as a server secret.
HUBSPOT_CREDENTIAL_KEY=

# Optional second factor after ChatGPT sign-in. Configure and test before enabling.
TWO_FACTOR_REQUIRED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Build-time bucket name used by vite.config.ts for the BUCKET binding.
# Create the bucket in Cloudflare R2 first, then set this in the Cloudflare build environment.
VERDEX_R2_BUCKET_NAME=
